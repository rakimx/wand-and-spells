{
	"format_version": "1.21.0",
	"minecraft:entity": {
		"description": {
			"identifier": "ws:grapple_vine",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"properties": {
				"ws:length": {
					"type": "float",
					"range": [0.1, 64.0],
					"default": 1.0,
					"client_sync": true
				},
				"ws:pitch": {
					"type": "float",
					"range": [-90.0, 90.0],
					"default": 0.0,
					"client_sync": true
				}
			}
		},
		"components": {
			"minecraft:type_family": { "family": [ "inanimate", "ws_vine" ] },
			"minecraft:collision_box": { "width": 0.01, "height": 0.01 },
			"minecraft:physics": { "has_gravity": false, "has_collision": false },
			"minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
			"minecraft:fire_immune": true,
			"minecraft:knockback_resistance": { "value": 1.0 },
			"minecraft:damage_sensor": {
				"triggers": [ { "cause": "all", "deals_damage": "no" } ]
			},
			"minecraft:timer": {
				"time": 30,
				"looping": false,
				"time_down_event": { "event": "ws:despawn" }
			}
		},
		"component_groups": {
			"ws:despawn": { "minecraft:instant_despawn": {} }
		},
		"events": {
			"ws:despawn": { "add": { "component_groups": [ "ws:despawn" ] } }
		}
	}
}