{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "ws:wizard",
            "materials": {
                "default": "entity_alphatest"
            },
            "textures": {
                "default": "textures/entity/wizard/wizard_0",
                "s0": "textures/entity/wizard/wizard_0",
                "s1": "textures/entity/wizard/wizard_1",
                "s2": "textures/entity/wizard/wizard_2",
                "s3": "textures/entity/wizard/wizard_3",
                "s4": "textures/entity/wizard/wizard_4",
                "s5": "textures/entity/wizard/wizard_5",
                "s6": "textures/entity/wizard/wizard_7",
                "s7": "textures/entity/wizard/wizard_8",
                "s8": "textures/entity/wizard/wizard_female_0",
                "s9": "textures/entity/wizard/wizard_female_1",
                "s10": "textures/entity/wizard/wizard_female_2"
            },
            "geometry": {
                "default": "geometry.ws.wizard"
            },
            "animations": {
                "look_at_target_default": "animation.humanoid.look_at_target.default",
                "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
                "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
                "look_at_target_controller": "controller.animation.humanoid.look_at_target",
                "move": "animation.humanoid.move",
                "move_controller": "controller.animation.humanoid.move",
                "holding": "animation.humanoid.holding",
                "holding_controller": "controller.animation.humanoid.holding",
                "attack.rotations": "animation.humanoid.attack.rotations",
                "attack_controller": "controller.animation.humanoid.attack",
                "bob": "animation.humanoid.bob",
                "bob_controller": "controller.animation.humanoid.bob"
            },
            "scripts": {
                "pre_animation": [
                    "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
                ],
                "animate": [
                    "look_at_target_controller",
                    "move_controller",
                    "holding_controller",
                    "attack_controller",
                    "bob_controller"
                ]
            },
            "enable_attachables": true,
            "spawn_egg": {
                "base_color": "#3f3f8f",
                "overlay_color": "#ffd84d"
            },
            "render_controllers": ["controller.render.ws_wizard"]
        }
    }
