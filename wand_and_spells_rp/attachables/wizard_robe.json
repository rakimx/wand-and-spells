{
    "format_version": "1.10.0",
    "minecraft:attachable": {
        "description": {
            "identifier": "ws:wizard_robe",
            "item": {
                "ws:wizard_robe": "query.is_owner_identifier_any('minecraft:player', 'ws:wizard', 'ws:evil_wizard')"
            },
            "materials": {
                "default": "armor",
                "enchanted": "armor_enchanted"
            },
            "textures": {
                "default": "textures/models/armor/wizard_layer_1",
                "enchanted": "textures/misc/enchanted_item_glint"
            },
            "geometry": {
                "default": "geometry.wizard_robe"
            },
            "render_controllers": [
                "controller.render.default"
            ]
        }
    }
}
