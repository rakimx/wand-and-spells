{
    "format_version": "1.10.0",
    "minecraft:attachable": {
        "description": {
            "identifier": "ws:healing_wand",
            "item": {
                "ws:healing_wand": "query.is_owner_identifier_any('minecraft:player', 'ws:wizard', 'ws:evil_wizard')"
            },
            "materials": {
                "default": "entity_alphatest",
                "enchanted": "entity_alphatest_glint"
            },
            "textures": {
                "default": "textures/items/wand_healing",
                "enchanted": "textures/misc/enchanted_item_glint"
            },
            "geometry": {
                "default": "geometry.ws.wand_held"
            },
            "animations": {
                "wand_controller": "controller.animation.wand",
                "hold_first_person": "animation.wand.hold_first_person",
                "hold_third_person": "animation.wand.hold_third_person",
                "cast_first_person": "animation.wand.cast_first_person"
            },
            "scripts": {
                "animate": [
                    "wand_controller"
                ]
            },
            "render_controllers": [
                "controller.render.default"
            ]
        }
    }
}
