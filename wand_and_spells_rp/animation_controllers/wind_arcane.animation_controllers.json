{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.ws_wind_arcane.pose": {
            "initial_state": "solto",
            "states": {
                "solto": {
                    "animations": [
                        "idle",
                        "walk"
                    ],
                    "transitions": [
                        {
                            "apontado": "query.property('ws:casting')"
                        }
                    ]
                },
                "apontado": {
                    "animations": [
                        "idle",
                        "walk",
                        "cast_use"
                    ],
                    "blend_transition": 0.05,
                    "transitions": [
                        {
                            "solto": "!query.property('ws:casting')"
                        }
                    ]
                }
            }
        }
    }
}
