{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "ws:tornado_smoke",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/particles/tornado_smoke"
            }
        },
        "components": {
            "minecraft:emitter_initialization": {
                "creation_expression": "variable.scale = variable.scale ?? 1;"
            },
            "minecraft:emitter_rate_instant": {
                "num_particles": "math.round(2 + variable.scale * 2)"
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 0.05
            },
            "minecraft:emitter_shape_disc": {
                "radius": "variable.scale",
                "plane_normal": "y",
                "direction": "outwards"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "1.6 + math.random(0, 0.9)"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(0, 360)",
                "rotation_rate": "math.random(-60, 60)"
            },
            "minecraft:particle_initial_speed": "0.5 + variable.scale * 0.2",
            "minecraft:particle_motion_dynamic": {
                "linear_drag_coefficient": 0.8,
                "linear_acceleration": [0, 1.6, 0]
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "math.clamp(0.28 * variable.scale, 0.18, 1.1)",
                    "math.clamp(0.28 * variable.scale, 0.18, 1.1)"
                ],
                "facing_camera_mode": "lookat_xyz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 64,
                    "flipbook": {
                        "base_UV": [0, 0],
                        "size_UV": [16, 16],
                        "step_UV": [0, 16],
                        "frames_per_second": 4,
                        "max_frame": 4,
                        "stretch_to_lifetime": true
                    }
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#E8FFFFFF",
                        "0.5": "#A0E4E9F2",
                        "1.0": "#00C2C8D1"
                    }
                }
            }
        }
    }
}
