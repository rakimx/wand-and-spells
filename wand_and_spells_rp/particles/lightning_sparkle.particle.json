{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ws:lightning_sparkle",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/lightning_spark_animated"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 10
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.35,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.3 + Math.random(0, 0.15)"
			},
			"minecraft:particle_initial_speed": "Math.random(1.2, 2.4)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 3.0
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.35, 0.35],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 64,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 20,
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_initial_spin": {
				"rotation": "Math.random(0, 360)",
				"rotation_rate": "Math.random(-180, 180)"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.5": "#A0EFFF",
						"1.0": "#00AEC900"
					}
				}
			}
		}
	}
}
