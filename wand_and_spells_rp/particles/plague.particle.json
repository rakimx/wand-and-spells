{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "ws:plague",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/particles/plague_mote"
            }
        },
        "components": {
            "minecraft:emitter_initialization": {
                "creation_expression": "variable.scale = variable.scale ?? 1; variable.r = variable.r ?? 0.15; variable.g = variable.g ?? 0.12; variable.b = variable.b ?? 0.18;"
            },
            "minecraft:emitter_rate_instant": {
                "num_particles": "math.round(4 + variable.scale * 4)"
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 0.05
            },
            "minecraft:emitter_shape_sphere": {
                "radius": "variable.scale * 0.35",
                "direction": "outwards"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "1.1 + math.random(0, 0.8)"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(0, 360)",
                "rotation_rate": "math.random(-50, 50)"
            },
            "minecraft:particle_initial_speed": "0.9 + variable.scale * 0.5",
            "minecraft:particle_motion_dynamic": {
                "linear_drag_coefficient": 1.6,
                "linear_acceleration": [0, -0.7, 0]
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "math.clamp(0.13 * variable.scale, 0.08, 0.45)",
                    "math.clamp(0.13 * variable.scale, 0.08, 0.45)"
                ],
                "facing_camera_mode": "lookat_xyz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 64,
                    "flipbook": {
                        "base_UV": [0, 0],
                        "size_UV": [16, 16],
                        "step_UV": [0, 16],
                        "frames_per_second": 5,
                        "max_frame": 4,
                        "stretch_to_lifetime": true
                    }
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    "variable.r",
                    "variable.g",
                    "variable.b",
                    "math.clamp(1.4 - 1.4 * v.particle_age / v.particle_lifetime, 0, 1)"
                ]
            }
        }
    }
}
