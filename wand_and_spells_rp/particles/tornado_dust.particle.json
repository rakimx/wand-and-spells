{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "ws:tornado_dust",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/particles/tornado_dust"
            }
        },
        "components": {
            "minecraft:emitter_initialization": {
                "creation_expression": "variable.scale = variable.scale ?? 1;"
            },
            "minecraft:emitter_rate_instant": {
                "num_particles": "math.round(3 + variable.scale * 3)"
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 0.05
            },
            "minecraft:emitter_shape_disc": {
                "radius": "variable.scale * 0.9",
                "plane_normal": "y",
                "direction": "outwards"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "0.8 + math.random(0, 0.5)"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(0, 360)",
                "rotation_rate": "math.random(-120, 120)"
            },
            "minecraft:particle_initial_speed": "0.8 + variable.scale * 0.3",
            "minecraft:particle_motion_dynamic": {
                "linear_drag_coefficient": 1.4,
                "linear_acceleration": [0, 3.2, 0]
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "math.clamp(0.16 * variable.scale, 0.1, 0.55)",
                    "math.clamp(0.16 * variable.scale, 0.1, 0.55)"
                ],
                "facing_camera_mode": "lookat_xyz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 64,
                    "flipbook": {
                        "base_UV": [0, 0],
                        "size_UV": [16, 16],
                        "step_UV": [0, 16],
                        "frames_per_second": 8,
                        "max_frame": 4,
                        "stretch_to_lifetime": true
                    }
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#FFFFFFFF",
                        "0.6": "#C0DDE2EC",
                        "1.0": "#00B4BCCB"
                    }
                }
            }
        }
    }
}
