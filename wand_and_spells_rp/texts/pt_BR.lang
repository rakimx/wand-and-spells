config.ws.generic.true=Habilitado
config.ws.generic.false=Desabilitado
config.ws.category.spells=Configuração de Feitiços
config.ws.category.spells.tooltip=Selecione quais feitiços estão habilitados
config.ws.title.spells=Configuração de Feitiços
config.ws.subtitle.spells=Desabilitar um feitiço globalmente aqui irá sobrescrever os controles mais específicos no arquivo JSON do feitiço.
config.ws.category.artefacts=Configuração de Artefatos
config.ws.category.artefacts.tooltip=Selecione quais artefatos estão habilitados
config.ws.title.artefacts=Configuração de Artefatos
config.ws.subtitle.artefacts=Desabilite anéis, amuletos ou encantamentos individuais aqui.
config.ws.category.gameplay=Configurações de Jogabilidade
config.ws.category.gameplay.tooltip=Configure a jogabilidade geral da magia
config.ws.title.gameplay=Configurações de Jogabilidade
config.ws.subtitle.gameplay=Configurações globais que afetam a mecânica do jogo.
config.ws.players_move_each_other=Jogadores Movem Uns aos Outros
config.ws.players_move_each_other.tooltip=Permite que jogadores movam outros jogadores usando magia.
config.ws.players_move_each_other.true=Sim - que comecem os jogos!
config.ws.players_move_each_other.false=Não - não serei empurrado por aí
config.ws.player_block_damage=Dano de Jogadores em Blocos
config.ws.player_block_damage.tooltip=Define se os feitiços lançados por jogadores podem destruir blocos no mundo. O Electroblob's Wizardry tenta respeitar mods e plugins de proteção, mas não pode garantir que funcionará em todos os casos. Se precisar de proteção anti-grief absoluta, desative esta opção. (Obs.: Esta opção afeta apenas jogadores. Para evitar que mobs destruam blocos com magia, use a regra do jogo mobGriefing.)
config.ws.player_block_damage.true=Sim - kaboom!
config.ws.player_block_damage.false=Não - ativar anti-grief (TM)
config.ws.dispenser_block_damage=Dano de Dispensadores em Blocos
config.ws.dispenser_block_damage.tooltip=Define se os feitiços lançados por dispensadores podem destruir blocos no mundo. O Electroblob's Wizardry tenta respeitar mods e plugins de proteção, mas não pode garantir que funcionará em todos os casos. Se precisar de proteção anti-grief absoluta, desative esta opção.
config.ws.damage_type_per_element=Tipo de Dano por Elemento
config.ws.damage_type_per_element.tooltip=Define se o dano deve ser registrado com o sistema antigo (wizardry_magic/indirect_wizardry_magic) prefixado com elementos como necromancy_indirect_wizardry_magic, necromancy_wizardry_magic. Isso está desabilitado por padrão para não corromper modpacks existentes. A intenção desta opção é permitir a diferenciação de vários tipos de dano, por exemplo, para o mod "Distinct Damage Descriptions"
config.ws.single_use_spell_books=Livros de Feitiço Consumidos por Varinhas
config.ws.single_use_spell_books.tooltip=Define se os livros de feitiço são consumidos quando vinculados a uma varinha.
config.ws.prevent_binding_same_spell_twice_to_wands=Prevenir Vinculação do Mesmo Feitiço Várias Vezes em uma Varinha
config.ws.prevent_binding_same_spell_twice_to_wands.tooltip=Define se deve impedir a vinculação do mesmo feitiço a uma varinha várias vezes.
config.ws.telekinetic_disarmament=Desarmamento Telecinético
config.ws.telekinetic_disarmament.tooltip=Define se permite que jogadores desarmem outros jogadores usando o feitiço de telecinese. Desative para evitar roubo de itens.
config.ws.telekinetic_disarmament.true=Sim - deixar as pessoas roubarem coisas
config.ws.telekinetic_disarmament.false=Não - isso é trapaça!
config.ws.teleport_through_unbreakable_blocks=Teletransporte Através de Blocos Inquebráveis
config.ws.teleport_through_unbreakable_blocks.tooltip=Define se é permitido aos jogadores se teleportarem através de blocos inquebráveis (por exemplo, bedrock) usando o feitiço de fase.
config.ws.teleport_through_unbreakable_blocks.true=Sim - Eu quero ver o vazio!
config.ws.teleport_through_unbreakable_blocks.false=Não - bedrock é impenetrável
config.ws.world_time_manipulation=Manipulação do Tempo do Mundo
config.ws.world_time_manipulation.tooltip=Define se é permitido aos jogadores alterar o tempo do mundo com o feitiço acelerar tempo. Se desabilitado, o feitiço acelerar tempo não mudará o tempo do mundo, mas ainda acelerará os ticks de blocos, entidades e entidades de bloco próximos.
config.ws.world_time_manipulation.true=Sim - dia, noite...
config.ws.world_time_manipulation.false=Não - Eu preciso dormir!
config.ws.creative_bypasses_arcane_lock=Ignorar Feitiço de Tranca Arcana no Modo Criativo
config.ws.creative_bypasses_arcane_lock.tooltip=Define quais jogadores podem ignorar trancas arcanas.
config.ws.creative_bypasses_arcane_lock.true=Qualquer um no modo criativo
config.ws.creative_bypasses_arcane_lock.false=Apenas operadores no modo criativo
config.ws.slow_time_affects_players=Tempo Lento Afeta Jogadores
config.ws.slow_time_affects_players.tooltip=Define se os jogadores ficam lentos quando outro jogador próximo usa o feitiço tempo lento. Se isso estiver desabilitado, mobs e projéteis ainda serão afetados, mas os jogadores se moverão na velocidade normal.
config.ws.bonemeal_grows_crystal_flowers=Farinha de Osso Faz Flores de Cristal Crescerem
config.ws.bonemeal_grows_crystal_flowers.tooltip=Define se usar farinha de osso em blocos de grama tem chance de fazer flores de cristal crescerem.
config.ws.wands_must_be_held_to_decrement_cooldown=Varinhas Precisam Ser Seguradas para Diminuir Tempo de Recarga
config.ws.wands_must_be_held_to_decrement_cooldown.tooltip=Define se as varinhas só diminuem seu tempo de recarga se um jogador as segurar.
config.ws.cooldown_reduction_per_level=Redução de Tempo de Recarga por Nível
config.ws.cooldown_reduction_per_level.tooltip=A fração pela qual os tempos de recarga são reduzidos para cada nível de melhoria de tempo de recarga.
config.ws.potency_increase_per_tier=Aumento de Potência por Nível de Varinha
config.ws.potency_increase_per_tier.tooltip=A fração pela qual a potência é aumentada para cada nível de varinha correspondente. Pode causar lag extremo com valores altos!
config.ws.duration_increase_per_level=Aumento de Duração por Nível
config.ws.duration_increase_per_level.tooltip=A fração pela qual a duração do feitiço é aumentada para cada nível de melhoria de duração.
config.ws.range_increase_per_level=Aumento de Alcance por Nível
config.ws.range_increase_per_level.tooltip=A fração pela qual o alcance do feitiço é aumentado para cada nível de melhoria de alcance. Pode causar lag extremo com valores altos!
config.ws.blast_increase_per_level=Aumento de Explosão por Nível
config.ws.blast_increase_per_level.tooltip=A fração pela qual a explosão do feitiço é aumentada para cada nível de melhoria de explosão. Pode causar lag extremo com valores altos!
config.ws.frost_slowness_increase_per_level=Aumento de Lentidão por Gelo por Nível
config.ws.frost_slowness_increase_per_level.tooltip=A fração pela qual a velocidade de movimento é reduzida por nível do efeito de gelo.
config.ws.category.difficulty=Dificuldade
config.ws.category.difficulty.tooltip=Configura a dificuldade do Electroblob's Wizardry
config.ws.title.difficulty=Dificuldade
config.ws.subtitle.difficulty=Configurações que afetam a dificuldade do mod.
config.ws.discovery_mode=Modo Exploração
config.ws.discovery_mode.tooltip=Para aqueles que gostam de mistério! Quando habilitado, os feitiços que você ainda não lançou ficarão ilegíveis até que você os use (por mundo). Não tem efeito no modo criativo. Feitiços de identificação serão impossíveis de obter no modo sobrevivência se esta opção estiver desabilitada.
config.ws.legacy_wand_levelling=Aprimoramento de Varinha Legado
config.ws.legacy_wand_levelling.tooltip=Controla se as varinhas são necessárias para ganhar progresso antes de serem aprimoradas para o próximo nível. Habilite esta opção para reverter para o sistema anterior à versão 4.2, que exigia apenas tomos arcanos. As varinhas ainda ganharão progresso silenciosamente quando esta opção estiver habilitada, portanto, se você voltar para o novo sistema, não perderá nenhum progresso.
config.ws.legacy_wand_levelling.true=Sim - Eu gostava do jeito que era!
config.ws.legacy_wand_levelling.false=Não - Sobe de nível ai pra mim!
config.ws.friendly_fire=Fogo Amigo
config.ws.friendly_fire.tooltip=Controla quais criaturas podem ser feridas por sua magia quando aliadas a você. Seus feitiços não alvejarão seus aliados ou criaturas invocadas/possuídas por eles, independentemente dessa configuração, mas essa opção os torna completamente imunes se desabilitada.
config.ws.passive_mobs_are_allies=Mobs Passivos São Aliados
config.ws.passive_mobs_are_allies.tooltip=Define se todos os mobs passivos devem ser considerados aliados, ou seja, eles não devem ser feridos indiretamente por feitiços. Mobs domados sempre contam como aliados.
config.ws.passive_mobs_are_allies.true=Sim - não machuque os animais!
config.ws.passive_mobs_are_allies.false=Não - Eu gosto do meu bife grelhado com eletricidade!
config.ws.minion_revenge_targeting=Alvos de Vingança de Lacaios
config.ws.minion_revenge_targeting.tooltip=Define se as criaturas invocadas podem atacar por vingança jogadores ou criaturas que elas não poderiam atacar de outra forma.
config.ws.minion_revenge_targeting.true=Sim - Eu nunca os machucaria!
config.ws.minion_revenge_targeting.false=Não - eles sempre devem me obedecer!
config.ws.forfeit_chance=Chance de Erro
config.ws.forfeit_chance.tooltip=A chance de 'interpretar mal' um feitiço não descoberto e acionar um erro. Definir esse valor como 0 efetivamente desativa a mecânica de erro. Não tem efeito se o modo exploração estiver desabilitado.
config.ws.progression_requirements=Requisitos de Progressão
config.ws.progression_requirements.tooltip=O progresso necessário para atualizar uma varinha para cada nível (aprendiz, avançado e mestre, respectivamente).
config.ws.player_damage_scaling=Fator de Escala de Dano do Jogador
config.ws.player_damage_scaling.tooltip=Fator de escala de dano global para o dano causado por jogadores lançando feitiços, em relação a 1.
config.ws.npc_damage_scaling=Fator de Escala de Dano de NPC
config.ws.npc_damage_scaling.tooltip=Fator de escala de dano global para o dano causado por NPCs lançando feitiços, em relação a 1.
config.ws.evil_wizard_spawn_rate=Taxa de Spawn de Magos Malignos
config.ws.evil_wizard_spawn_rate.tooltip=Taxa de spawn para magos malignos naturalmente spawnados; números mais altos significam que mais magos malignos irão aparecer. 5 é equivalente a bruxas, 100 é equivalente a zumbis, esqueletos e creepers. Defina como 0 para desabilitar completamente o spawn de magos malignos.
config.ws.ice_wraith_spawn_rate=Taxa de Spawn de Espectros de Gelo
config.ws.ice_wraith_spawn_rate.tooltip=Taxa de spawn para espectros de gelo naturalmente spawnados; números mais altos significam que mais espectros de gelo irão aparecer. 5 é equivalente a bruxas, 100 é equivalente a zumbis, esqueletos e creepers. Defina como 0 para desabilitar completamente o spawn de espectros de gelo.
config.ws.lightning_wraith_spawn_rate=Taxa de Spawn de Espectros de Relâmpago
config.ws.lightning_wraith_spawn_rate.tooltip=Taxa de spawn para espectros de relâmpago naturalmente spawnados; números mais altos significam que mais espectros de relâmpago irão aparecer. 5 é equivalente a bruxas, 100 é equivalente a zumbis, esqueletos e creepers. Defina como 0 para desabilitar completamente o spawn de espectros de relâmpago.
config.ws.category.tweaks=Configurações de Ajustes
config.ws.category.tweaks.tooltip=Ajuste o comportamento do Electroblob's Wizardry
config.ws.title.tweaks=Configurações de Ajustes
config.ws.subtitle.tweaks=Configurações diversas para ajustar o comportamento do mod.
config.ws.replace_vanilla_fireballs=Substituir Bolas de Fogo da Vanilla
config.ws.replace_vanilla_fireballs.tooltip=Define se as bolas de fogo do próprio Minecraft serão substituídas pelas bolas de fogo do Electroblob's Wizardry. Se desabilitado, apenas os feitiços do Electroblob's Wizardry usarão as bolas de fogo personalizadas.
config.ws.replace_vanilla_fireballs.true=Sim - me dê FOGO!
config.ws.replace_vanilla_fireballs.false=Não - os Blazes já são maus o suficiente
config.ws.replace_vanilla_fall_damage=Substituir Dano de Queda da Vanilla
config.ws.replace_vanilla_fall_damage.tooltip=Define se o cálculo de dano de queda baseado na distância do Minecraft será substituído por um equivalente baseado na velocidade. Isso é feito para que mobs em queda livre sofram exatamente o mesmo dano que o normal, para não prejudicar fazendas de mobs baseadas em queda. Desative isso se você tiver problemas estranhos relacionados à queda! Se desabilitado, alguns feitiços voltam a um método mais simplista de zerar o dano de queda do jogador em certos casos.
config.ws.replace_vanilla_fall_damage.true=Sim - é hora do parkour!
config.ws.replace_vanilla_fall_damage.false=Não - quebrar minhas pernas normalmente
config.ws.blindness_tweak=Ajuste de Cegueira
config.ws.blindness_tweak.tooltip=Define se deve ajustar o efeito de cegueira para reduzir a distância de perseguição quando usado em entidades não-jogadoras. Isso se desativa automaticamente em favor da implementação do Potion Core, se instalado.
config.ws.mob_loot_table_whitelist=Lista de Permissão de Tabela de Loot de Mobs
config.ws.mob_loot_table_whitelist.tooltip=Lista de permissão para tabelas de loot para injetar drops adicionais de mobs (conforme especificado em loot_tables/entities/mob_additions.json). O Electroblob's Wizardry tenta adivinhar quais tabelas de loot pertencem a mobs hostis, mas isso pode nem sempre estar correto ou ser apropriado; adicione manualmente os locais das tabelas de loot (não IDs de entidade) a esta lista para incluí-las.
config.ws.mob_loot_table_blacklist=Lista de Bloqueio de Tabela de Loot de Mobs
config.ws.mob_loot_table_blacklist.tooltip=Lista de bloqueio para tabelas de loot para injetar drops adicionais de mobs (conforme especificado em loot_tables/entities/mob_additions.json) into. O Electroblob's Wizardry tenta adivinhar quais tabelas de loot pertencem a mobs hostis, mas isso pode nem sempre estar correto ou ser apropriado; adicione manualmente os locais das tabelas de loot (não IDs de entidade) a esta lista para excluí-las.
config.ws.inject_mob_drops=Permitir Drops de Mobs do Wizardry
config.ws.inject_mob_drops.tooltip=Define se deve injetar loot do Wizardry em mobs, de acordo com as configurações da 'Lista de Permissão de Tabela de Loot de Mobs' / 'Lista de Bloqueio de Tabela de Loot de Mobs'. Se desabilitado, as listas não terão nenhum efeito!
config.ws.mob_spawn_dimensions=Dimensões de Spawn de Mobs
config.ws.mob_spawn_dimensions.tooltip=Lista de IDs de dimensões nas quais os mobs hostis do Wizardry podem surgir.
config.ws.mob_spawn_biome_blacklist=Lista de Bloqueio de Bioma de Spawn de Mobs
config.ws.mob_spawn_biome_blacklist.tooltip=Lista de nomes de biomas nos quais mobs hostis do Wizardry não podem surgir. Os nomes dos biomas não diferenciam maiúsculas e minúsculas. Para biomas de mod, use o prefixo do ID do mod (por exemplo, biomesoplenty:mystic_grove).
config.ws.summoned_creature_targets_whitelist=Lista de Permissão de Alvos de Criaturas Invocadas
config.ws.summoned_creature_targets_whitelist.tooltip=Lista de nomes de entidades que as criaturas e magos invocados podem atacar, além dos padrões. Adicione criaturas de mod a esta lista se quiser que criaturas invocadas as ataquem e elas ainda não o estejam fazendo. Os nomes das entidades não diferenciam maiúsculas e minúsculas. Para entidades de mod, use o prefixo do ID do mod (por exemplo, ws:wizard).
config.ws.summoned_creature_targets_blacklist=Lista de Bloqueio de Alvos de Criaturas Invocadas
config.ws.summoned_creature_targets_blacklist.tooltip=Lista de nomes de entidades que as criaturas e magos invocados não têm permissão específica para atacar, substituindo os padrões e a lista de permissão. Adicione criaturas a esta lista se permitir que sejam atacadas cause problemas ou seja muito destrutivo (remover creepers desta lista é por sua própria conta e risco!). Os nomes das entidades não diferenciam maiúsculas e minúsculas. Para entidades de mod, use o prefixo do ID do mod (por exemplo, ws:wizard).
config.ws.mind_control_targets_blacklist=Lista de Bloqueio de Alvos de Controle Mental
config.ws.mind_control_targets_blacklist.tooltip=Lista de nomes de entidades que não podem ser controladas mentalmente, além dos padrões. Adicione criaturas a esta lista se permitir que sejam controladas mentalmente cause problemas ou possa ser explorado. Os nomes das entidades não diferenciam maiúsculas e minúsculas. Para entidades de mod, use o prefixo do ID do mod (por exemplo, ws:wizard).
config.ws.pocket_furnace_item_blacklist=Lista de Bloqueio de Itens da Fornalha de Bolso
config.ws.pocket_furnace_item_blacklist.tooltip=Lista de nomes de registro de blocos ou itens que não podem ser fundidos pelo feitiço de fornalha de bolso, além de armaduras, ferramentas e armas. Os nomes de blocos/itens não diferenciam maiúsculas e minúsculas. Para itens de mod, use o prefixo do ID do mod (por exemplo, ws:crystal_ore).
config.ws.divination_ore_whitelist=Lista de Permissão de Minérios de Adivinhação
config.ws.divination_ore_whitelist.tooltip=Lista de nomes de registro de blocos de minério que podem ser detectados pelo feitiço de adivinhação. Os nomes dos blocos não diferenciam maiúsculas e minúsculas. Para blocos de mod, use o prefixo do ID do mod (por exemplo, ws:crystal_ore).
config.ws.sword_item_whitelist=Lista de Permissão de Espadas
