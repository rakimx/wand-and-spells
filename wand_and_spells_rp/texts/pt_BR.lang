item.ws:scroll.undiscovered.name=Pergaminho "%1$s"
item.ws:scroll.desc=Uma folha encantada de um pergaminho amarrada frouxamente com barbante. No pergaminho está escrita um encantamento de algum tipo, presumivelmente para ser lida em voz alta.\n\nClique com o botão direito enquanto segura este pergaminho para usá-lo.
item.ws:identification_scroll.name=Pergaminho de Identificação
item.ws:identification_scroll.desc=Identifica um livro de feitiços ou pergaminho desconhecido
item.ws:identification_scroll.desc_extended=Clique com o botão direito enquanto segura este pergaminho para identificar o primeiro livro de feitiços ou pergaminho desconhecido na sua barra de acesso rápido.
item.ws:identification_scroll.nothing_to_identify=Nada para identificar!
item.ws:resplendent_thread.name=Fio Resplandecente
item.ws:resplendent_thread.desc=Aprimora uma armadura mágica regular em uma armadura de sábio.
item.ws:resplendent_thread.desc_extended=Uma linha de seda cintilante usada para bordar as melhores vestes com símbolos arcanos, melhorando sua capacidade de encantamento.\n\nAplique esta melhoria a uma peça de armadura mágica na Mesa de Trabalho Arcana.
item.ws:crystal_silver_plating.name=Revestimento de Cristal e Prata
item.ws:crystal_silver_plating.desc=Aprimora armadura mágica regular em armadura de mago guerreiro.
item.ws:crystal_silver_plating.desc_extended=Uma liga quase mítica, forjada nas fundições de Eldar, com propriedades excepcionais de deflexão mágica.\n\nAplique esta melhoria a uma peça de armadura mágica na Mesa de Trabalho Arcana.
item.ws:ethereal_crystalweave.name=Tramas de Cristal Etéreo
item.ws:ethereal_crystalweave.desc=Aprimora armadura mágica regular em armadura de feiticeiro.
item.ws:ethereal_crystalweave.desc_extended=Um tecido encantado tão espesso quanto a pele de um animal, mas que de alguma forma parece mais leve que papel nas mãos.\n\nAplique esta melhoria a uma peça de armadura mágica na Mesa de Trabalho Arcana.
